# Copy this file to .env and fill in the credentials you create.
# Keep backend/.env private; never commit or share its values.

# Google Cloud Console -> enable YouTube Data API v3 -> create API key
YOUTUBE_API_KEY=

# Optional: customize the broad global-news sampling query (no API key needed).
# Use GDELT DOC Boolean syntax, for example: (climate OR election OR technology)
# TRENDSENSE_GDELT_QUERY=(AI OR technology OR election OR conflict OR war OR economy OR inflation OR climate OR earthquake OR flood OR storm OR protest OR summit OR sports OR entertainment)
